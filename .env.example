# ─── Echo — variables de entorno ─────────────────────────────────
# Copiá este archivo a .env y completá los valores.
# NUNCA commitees .env con credenciales reales.

# Database
DATABASE_URL=postgresql+asyncpg://echo:echo_dev_pw@localhost:5433/echo
POSTGRES_USER=echo
POSTGRES_PASSWORD=echo_dev_pw
POSTGRES_DB=echo

# Auth
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Encryption (API keys de providers se guardan cifradas con esta clave)
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_fernet_key

# URLs
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:8787

# Superadmins de la instalación, separados por coma. Ven todas las
# organizaciones y les configuran la IA. Se aplica al arrancar la API; sacar
# un email de acá le quita el privilegio en el próximo reinicio.
SUPERADMIN_EMAILS=

# Google OAuth (crear cuenta / iniciar sesión con Google).
# Vacío = el botón de Google no aparece. El callback que hay que registrar
# en Google Cloud Console es {API_PUBLIC_URL}/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# AI providers (opcionales — también configurables por organización desde la UI)
# Estas actúan como default global si la organización no configuró nada.
# Proveedor del chat/minutas si la organización no configuró uno.
# Vacío = autodetectar. Explicitarlo evita que una key cargada para STT
# (ej. OpenAI) cambie sin querer el modelo del chat.
DEFAULT_LLM_PROVIDER=
# Modelo del default del servidor. Vacío = el que Echo trae por proveedor.
# Sirve para apuntar a un modelo gratuito (ej. uno ":free" de OpenRouter) sin
# tocar código: esto es lo que usa toda organización que no configuró el suyo.
DEFAULT_LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
OPENROUTER_API_KEY=
# OrcaRouter (compatible con OpenAI). Acepta varios modelos separados por
# coma en DEFAULT_LLM_MODEL: se prueban en orden hasta que uno responda.
ORCAROUTER_API_KEY=
# GMI Cloud (OpenAI-compatible) — modelo por defecto MiniMaxAI/MiniMax-M3
GMI_API_KEY=
OLLAMA_BASE_URL=

# Local bridge (Echo Bridge)
BRIDGE_PORT=8974

# Entorno
ECHO_ENV=development
